---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  moment: CollectionEntry<"moments">;
}

const { moment } = Astro.props;
const { title, date, description, gallery } = moment.data;

const images = await Promise.all(
  gallery
    .slice(0, 9)
    .map((src) => getImage({ src, width: 1600, format: "webp", quality: 82 }))
);

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<a class="story-preview" href={`/moments/${moment.id}/`} data-interval="5000">
  <div class="story-preview-media">
    {
      images.map((img, i) => (
        <img
          src={img.src}
          class="story-preview-slide"
          class:list={[{ active: i === 0 }]}
          alt=""
          loading={i === 0 ? "eager" : "lazy"}
        />
      ))
    }
    <div class="story-preview-scrim"></div>
  </div>
  <div class="story-preview-copy">
    <span class="badge light">milestone</span>
    <h2>{title}</h2>
    <span class="date light">{formattedDate}</span>
    {description && <p>{description}</p>}
    <span class="story-preview-cta">View the full story &rarr;</span>
  </div>
</a>

<style>
  .story-preview {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    aspect-ratio: 16 / 9;
    text-decoration: none;
    color: inherit;
    margin-bottom: 2rem;
  }

  .story-preview-media {
    position: absolute;
    inset: 0;
  }

  .story-preview-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.4s ease;
  }

  .story-preview-slide.active {
    opacity: 1;
  }

  .story-preview-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(20, 14, 8, 0.85) 0%,
      rgba(20, 14, 8, 0.35) 45%,
      rgba(20, 14, 8, 0.05) 75%
    );
  }

  .story-preview-copy {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.35rem;
    padding: 1.5rem;
    color: #fff;
  }

  .story-preview-copy h2 {
    font-size: clamp(1.4rem, 4vw, 2.1rem);
    color: #fff;
  }

  .badge.light {
    align-self: flex-start;
    color: var(--color-accent-2);
  }

  .date.light {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.85rem;
  }

  .story-preview-copy p {
    margin: 0;
    max-width: 60ch;
    color: rgba(255, 255, 255, 0.9);
  }

  .story-preview-cta {
    margin-top: 0.5rem;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .story-preview-slide {
      transition: none;
    }
  }
</style>

<script>
  function startStoryPreviews() {
    document.querySelectorAll<HTMLElement>(".story-preview").forEach((root) => {
      const slides = Array.from(
        root.querySelectorAll<HTMLImageElement>(".story-preview-slide")
      );
      if (slides.length < 2) return;

      const interval = Number(root.dataset.interval) || 5000;
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      if (reduceMotion) return;

      let index = 0;
      setInterval(() => {
        slides[index].classList.remove("active");
        index = (index + 1) % slides.length;
        slides[index].classList.add("active");
      }, interval);
    });
  }

  startStoryPreviews();
</script>
