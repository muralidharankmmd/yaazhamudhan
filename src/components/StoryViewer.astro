---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  moment: CollectionEntry<"moments">;
}

const { moment } = Astro.props;
const { title, gallery, videos } = moment.data;

// Full quality for the immersive view: capped at 2560px and encoded as
// AVIF at high quality, which is visually indistinguishable from the
// original but a fraction of the file size.
const images = await Promise.all(
  gallery.map((src) => getImage({ src, width: 2560, format: "avif", quality: 90 }))
);

const total = images.length + videos.length;
---

<div class="story-viewer">
  <a class="story-close" href="/" aria-label="Back to all moments">&times;</a>

  <div class="story-stage">
    {
      videos.map((src, i) => (
        <video
          class="story-slide"
          class:list={[{ active: i === 0 }]}
          src={src}
          controls
          preload="none"
          playsinline
        />
      ))
    }
    {
      images.map((img, i) => (
        <img
          class="story-slide"
          class:list={[{ active: videos.length === 0 && i === 0 }]}
          src={img.src}
          alt={title}
          loading={videos.length === 0 && i === 0 ? "eager" : "lazy"}
        />
      ))
    }
  </div>

  {
    total > 1 && (
      <>
        <button class="story-nav prev" aria-label="Previous">
          &#8249;
        </button>
        <button class="story-nav next" aria-label="Next">
          &#8250;
        </button>
        <div class="story-counter">
          <span class="current">1</span> / <span>{total}</span>
        </div>
      </>
    )
  }
</div>

<style>
  .story-viewer {
    position: relative;
    width: 100%;
    height: 100dvh;
    background: #000;
    overflow: hidden;
  }

  .story-stage {
    position: absolute;
    inset: 0;
  }

  .story-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .story-slide.active {
    opacity: 1;
    pointer-events: auto;
  }

  .story-close {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    z-index: 5;
    font-size: 2.25rem;
    line-height: 1;
    color: #fff;
    text-decoration: none;
    opacity: 0.85;
  }

  .story-close:hover {
    opacity: 1;
  }

  .story-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.4);
    color: #fff;
    font-size: 1.75rem;
    cursor: pointer;
  }

  .story-nav.prev {
    left: 1rem;
  }

  .story-nav.next {
    right: 1rem;
  }

  .story-counter {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    color: #fff;
    background: rgba(0, 0, 0, 0.4);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    font-size: 0.85rem;
  }
</style>

<script>
  function initStoryViewer() {
    const root = document.querySelector<HTMLElement>(".story-viewer");
    if (!root) return;

    const slides = Array.from(
      root.querySelectorAll<HTMLImageElement | HTMLVideoElement>(".story-slide")
    );
    const prevBtn = root.querySelector<HTMLButtonElement>(".prev");
    const nextBtn = root.querySelector<HTMLButtonElement>(".next");
    const counter = root.querySelector<HTMLElement>(".story-counter .current");

    let index = 0;

    function show(next: number) {
      const current = slides[index];
      if (current instanceof HTMLVideoElement) current.pause();
      current.classList.remove("active");

      index = (next + slides.length) % slides.length;
      slides[index].classList.add("active");
      if (counter) counter.textContent = String(index + 1);
    }

    prevBtn?.addEventListener("click", () => show(index - 1));
    nextBtn?.addEventListener("click", () => show(index + 1));

    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(index - 1);
      if (e.key === "ArrowRight") show(index + 1);
      if (e.key === "Escape") window.location.href = "/";
    });

    slides.forEach((slide) => {
      if (slide instanceof HTMLVideoElement) {
        slide.addEventListener("ended", () => show(index + 1));
      }
    });

    let touchStartX = 0;
    root.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.changedTouches[0].clientX;
      },
      { passive: true }
    );
    root.addEventListener(
      "touchend",
      (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
      },
      { passive: true }
    );
  }

  initStoryViewer();
</script>
