---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StoryViewer from "../../components/StoryViewer.astro";
import { getYouTubeEmbedUrl } from "../../lib/youtube";

export async function getStaticPaths() {
  const moments = await getCollection("moments");
  return moments.map((moment) => ({
    params: { slug: moment.id },
    props: { moment },
  }));
}

const { moment } = Astro.props;
const { title, date, type, description, cover, gallery, videos, embeds, links } =
  moment.data;
const { Content } = await render(moment);

const icon = type === "achievement" ? "🏆" : type === "milestone" ? "🌱" : "📸";

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={`${title} — Yaazhamudhan`} description={description}>
  {
    moment.data.story ? (
      <StoryViewer moment={moment} />
    ) : (
      <div class="wrap detail">
        <a class="back-link" href="/">
          &larr; Back to all moments
        </a>

        <div class="detail-hero">
          {cover ? (
            <Image src={cover} alt={title} width={1000} height={562} />
          ) : (
            <div class="placeholder">{icon}</div>
          )}
        </div>

        <header>
          <span class="badge">{type}</span>
          <h1>{title}</h1>
          <span class="date">{formattedDate}</span>
        </header>

        <Content />

        {gallery.length > 0 && (
          <div class="gallery">
            {gallery.map((img) => (
              <Image src={img} alt={title} width={360} height={360} />
            ))}
          </div>
        )}

        {videos.length > 0 && (
          <div class="videos">
            {videos.map((src) => (
              <video controls preload="metadata" src={src} />
            ))}
          </div>
        )}

        {embeds.length > 0 && (
          <div class="embeds">
            {embeds.map((url) => {
              const embedUrl = getYouTubeEmbedUrl(url);
              return (
                embedUrl && (
                  <div class="embed-frame">
                    <iframe
                      src={embedUrl}
                      title={title}
                      loading="lazy"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                    />
                  </div>
                )
              );
            })}
          </div>
        )}

        {links.length > 0 && (
          <div class="links">
            {links.map((link) => (
              <a class="link-card" href={link.url} target="_blank" rel="noopener noreferrer">
                {link.label} &rarr;
              </a>
            ))}
          </div>
        )}
      </div>
    )
  }
</BaseLayout>
